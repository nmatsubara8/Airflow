[Unit]
Description=Airflow Task Dispatcher (polling loop)
Documentation=https://github.com/nmatsubara8/airflow
After=network.target airflow-taskboard.service

[Service]
Type=simple
WorkingDirectory=/opt/airflow
EnvironmentFile=/opt/airflow/.env
ExecStart=python -m airflow_mcp.dispatcher.main
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=airflow-dispatcher

[Install]
WantedBy=multi-user.target
