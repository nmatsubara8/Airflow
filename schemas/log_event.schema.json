{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airflow.local/schemas/log_event/v1.0.0",
  "title": "LogEvent",
  "type": "object",
  "required": ["timestamp", "level", "event", "audit_id", "component"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\." },
    "timestamp": { "type": "string", "format": "date-time" },
    "level": { "type": "string", "enum": ["debug", "info", "warn", "error", "critical"] },
    "event": {
      "type": "string",
      "description": "ドット区切りイベント名 例: task.created, model.executed"
    },
    "audit_id": { "type": "string" },
    "parent_audit_id": { "type": ["string", "null"] },
    "component": {
      "type": "string",
      "enum": ["taskboard-mcp", "notes-mcp", "models-mcp", "gpu-mcp", "agents-mcp", "scheduler", "dispatcher", "cleaner", "ingester", "cli"]
    },
    "task_id": { "type": ["string", "null"] },
    "agent_id": { "type": ["string", "null"] },
    "model_id": { "type": ["string", "null"] },
    "duration_ms": { "type": ["integer", "null"] },
    "error": {
      "type": ["object", "null"],
      "description": "DDD-03 §2.2 のエラーレスポンス構造（サマリーフィールド）",
      "properties": {
        "class": { "type": "string", "enum": ["recoverable", "escalate", "fatal"] },
        "code": { "type": "string", "description": "DDD-03 §2.4 で定義するエラーコード" },
        "message": { "type": "string" },
        "retry_after_ms": { "type": ["integer", "null"], "minimum": 0 },
        "audit_id": { "type": ["string", "null"], "description": "元の audit_id（DDD-03 §5）" }
      }
    },
    "data": {
      "type": "object",
      "description": "イベント固有のペイロード"
    }
  }
}
