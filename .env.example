# Airflow MCP — 環境変数テンプレート
# このファイルを .env にコピーして値を設定してください:
#   cp .env.example .env

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_STUB=false                     # true = モックモード（テスト用）

# ── タスクボード ──────────────────────────────────────────────────────────────
AIRFLOW_TASKBOARD_DIR=.airflow/tasks  # タスク JSON 保存ディレクトリ
AIRFLOW_EXECUTION_LOG=.airflow/state/execution.jsonl

# ── Vault (Obsidian) ─────────────────────────────────────────────────────────
VAULT_ROOT=/path/to/your/obsidian/vault   # 要変更

# ── 認証トークン (Phase 2: API key) ─────────────────────────────────────────
AIRFLOW_MCP_TOKEN_ADMIN=airflow_local_<32文字のランダム文字列>
AIRFLOW_MCP_TOKEN_AGENT=airflow_local_<32文字のランダム文字列>
AIRFLOW_MCP_TOKEN_READONLY=airflow_local_<32文字のランダム文字列>

# ── HTTP 認証 (メトリクス/ダッシュボード用) ──────────────────────────────────
AIRFLOW_HTTP_AUTH_TOKEN=             # 空 = 認証なし（開発用）

# ── Slack 通知 ────────────────────────────────────────────────────────────────
AIRFLOW_SLACK_WEBHOOK=               # 例: https://hooks.slack.com/services/...
# SLACK_WEBHOOK_URL=                 # notifications.yaml の ${SLACK_WEBHOOK_URL} 参照

# ── SMTP メール通知 ───────────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASSWORD=

# ── JWT (Phase 5 — 現在は未使用) ─────────────────────────────────────────────
# AIRFLOW_JWT_PRIVATE_KEY_PATH=.airflow/keys/private.pem
# AIRFLOW_JWT_PUBLIC_KEY_PATH=.airflow/keys/public.pem

# ── デバッグ ──────────────────────────────────────────────────────────────────
# AIRFLOW_AUTH_LOCALHOST_BYPASS=true   # 127.0.0.1 からの認証をスキップ（開発用）
