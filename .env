# Airflow MCP — 環境変数テンプレート
# このファイルを .env にコピーして値を設定してください:
#   cp .env.example .env
#
# ── Docker Compose クイックスタート ─────────────────────────────────────────
#   1. cp .env.example .env
#   2. VAULT_ROOT と AIRFLOW_MCP_TOKEN_* を編集（← 必須）
#   3. docker compose up -d ollama
#   4. docker compose exec ollama ollama pull qwen2.5:14b-instruct-q4_K_M
#   5. docker compose up -d
#   ダッシュボード: http://localhost:7400
#   メトリクス:    http://localhost:9090/metrics
#
# ── MCP サーバー（Claude Desktop 用）────────────────────────────────────────
#   MCP サーバー（taskboard/notes/models/gpu/agents）は stdio ベース。
#   claude_desktop_config.json の mcpServers に以下形式で登録:
#     "command": "<プロジェクトパス>/deploy/mcp-start.sh",
#     "args": ["taskboard"]

# ── Ollama ───────────────────────────────────────────────────────────────────
# ローカル直接実行時はそのまま使用。
# Docker Compose 内では各サービスが http://ollama:11434 に上書きするため変更不要。
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_STUB=false   # true = モックモード（Ollama なしで起動テスト可）

# ── タスクボード ──────────────────────────────────────────────────────────────
# Docker Compose 内では /data/tasks に上書き済み。
AIRFLOW_TASKBOARD_DIR=.airflow/tasks
AIRFLOW_EXECUTION_LOG=.airflow/state/execution.jsonl

# ── Vault (Obsidian) ─────────────────────────────────────────────────────────
VAULT_ROOT=D:\vaults\youtube-knowledge   # ← 要変更

# ── 認証トークン ──────────────────────────────────────────────────────────────
# 生成コマンド例: python -c "import secrets; print('airflow_local_' + secrets.token_hex(16))"
AIRFLOW_MCP_TOKEN_ADMIN=airflow_local_eaa33485c3fdfba480801956fd19471d
AIRFLOW_MCP_TOKEN_AGENT=airflow_local_2801582282e57d91ff3d54e75845475a
AIRFLOW_MCP_TOKEN_READONLY=airflow_local_ef93e847710dad72318f141c38d11dc5

# ── HTTP 認証 (ダッシュボード :7400 / メトリクス :9090) ───────────────────────
AIRFLOW_HTTP_AUTH_TOKEN=

# ── Slack 通知 ────────────────────────────────────────────────────────────────
AIRFLOW_SLACK_WEBHOOK=     # 例: https://hooks.slack.com/services/...

# ── SMTP メール通知 ───────────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASSWORD=

# ── デバッグ ──────────────────────────────────────────────────────────────────
AIRFLOW_AUTH_LOCALHOST_BYPASS=true   # 127.0.0.1 からの認証をスキップ（開発用）
AIRFLOW_MCP_TOKEN=airflow_local_11ef2b090d889dbd1dc1aedf92fa51cd
UID=1000
GID=1000
